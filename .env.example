# Local development only. Replace this value before starting the compose stack.
POSTGRES_DB=seasonplan
# Initialization/migration owner. Do not use it for runtime requests.
POSTGRES_USER=seasonplan_owner
POSTGRES_PASSWORD=change-this-local-owner-password
DB_RUNTIME_USER=seasonplan_app
DB_RUNTIME_PASSWORD=change-this-local-runtime-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
DEV_ADMIN_USERNAME=dev-admin
DEV_ADMIN_PASSWORD=change-this-development-admin-password
DEV_ADMIN_DISPLAY_NAME=Development Administrator
